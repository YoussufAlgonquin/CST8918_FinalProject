# Required. Sign up for a free key at https://home.openweathermap.org/users/sign_up
WEATHER_API_KEY=

# Optional - omit REDIS_HOST to use an in-memory cache for local dev.
# In test/prod these are set on the k8s deployment from infra/modules/weather-app.
REDIS_HOST=
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=true
